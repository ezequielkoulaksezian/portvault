# Public URL of the site (used for canonical URLs, the sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://portvault.vercel.app

# Google AdSense. Leave empty to disable ads; /ads.txt is generated from the client ID.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# Donation links. Each method is shown only when its URL is set.
NEXT_PUBLIC_DONATE_GITHUB_SPONSORS=
NEXT_PUBLIC_DONATE_KOFI=
NEXT_PUBLIC_DONATE_CAFECITO=
